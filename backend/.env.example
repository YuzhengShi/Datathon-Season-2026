# Copy to backend/.env. Never put the key in dist/ or browser JavaScript.
DATA_MODE=demo
DATABASE_URL=sqlite:///./data/live.db
DEMO_DATABASE_URL=sqlite:///./data/demo.db
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Empty = official OpenAI endpoint. DeepSeek: https://api.deepseek.com/v1
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ROUNDS=4
LLM_MAX_TOOL_CALLS=6
LLM_MAX_OUTPUT_TOKENS=1800
# Optional comma-separated origins for a separately hosted frontend. Empty = same origin.
CORS_ORIGINS=
