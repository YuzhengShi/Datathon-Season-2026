# Copy to .env. Every entry point (API, CLI, migrations, reports) resolves settings the same way.
DATA_MODE=live
DATABASE_URL=sqlite:///./data/navigator.db
DEMO_DATABASE_URL=sqlite:///./data/demo/navigator.db
DATA_DIR=./data
SOURCE_CONFIG=./sources.yaml
LOG_LEVEL=INFO
FETCH_TIMEOUT_SECONDS=30
FETCH_MAX_BYTES=10485760
FETCH_RETRIES=3
FETCH_PER_HOST_CONCURRENCY=1
FETCH_MIN_INTERVAL_SECONDS=1
FRESHNESS_DAYS=30
EXTRACTION_MODE=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional extras (not in the required list):
# CORS_ALLOW_ORIGINS=http://localhost:3000        # comma-separated explicit origins; empty = CORS disabled
# USER_AGENT=IndigenousFundingNavigatorBot/0.1 (+mailto:you@example.org)   # identify yourself to source sites
